# LLM (gemini | ollama) — overrides llm.yaml when set
# LLM_ACTIVE=gemini
# GOOGLE_API_KEY=

# Google model — alias from llm.yaml or full model id (intent + agent + chat)
# Default in llm.yaml: flash → gemini-2.5-flash
# GOOGLE_MODEL=pro          # gemini-2.5-pro (best quality, slower/costlier)
# GOOGLE_MODEL=flash        # gemini-2.5-flash (default)
# GOOGLE_MODEL=gemma-26b    # gemma-4-26b-a4b-it (legacy)
# AGENT_MODEL=              # alias for GOOGLE_MODEL (backward compatible)

# Polygon — options contract reference only
# POLYGON_API_KEY=your_key_here
# POLYGON_BASE_URL=https://api.polygon.io

# Finnhub — peers, news sentiment, earnings (free at finnhub.io)
# FINNHUB_API_KEY=your_key_here

# Environment: development | production (Render sets production)
# APP_ENV=development

# Production (Render): comma-separated frontend origin(s), no trailing slash
# CORS_ORIGINS=https://thetalens.app,https://www.thetalens.app

# Optional: protects GET /api/runtime in production (X-Admin-Key header)
# ADMIN_API_KEY=

# Production scaling (optional rate limits; Redis via REDIS_URL on Render)
# REDIS_URL=redis://...          # set automatically on Render when using render.yaml
# RATE_LIMIT_AGENT_STREAM=12/minute
# RATE_LIMIT_SCANNER=25/minute
