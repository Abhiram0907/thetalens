# LLM (gemini | ollama) — overrides llm.yaml when set
# LLM_ACTIVE=gemini
# GOOGLE_API_KEY=

# Agent model — defaults to Gemma 4 26B (gemma-4-26b-a4b-it)
# AGENT_MODEL=gemma-4-26b-a4b-it

# Polygon — options contract reference only
# POLYGON_API_KEY=your_key_here
# POLYGON_BASE_URL=https://api.polygon.io

# Finnhub — peers, news sentiment, earnings (free at finnhub.io)
# FINNHUB_API_KEY=your_key_here

# Environment: development | production (Render sets production)
# APP_ENV=development

# Production (Render): comma-separated frontend origin(s), no trailing slash
# CORS_ORIGINS=https://thetalens.app,https://www.thetalens.app

# Optional: protects GET /api/runtime in production (X-Admin-Key header)
# ADMIN_API_KEY=
